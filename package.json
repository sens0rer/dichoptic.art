{
	"name": "dichoptic.art",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db": "tsx scripts/db.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"seed": "tsx scripts/seed.ts",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.4",
		"@types/qrcode": "^1.5.6",
		"dotenv": "^18.0.5",
		"drizzle-kit": "^0.31.11",
		"embedded-postgres": "^18.4.0-beta.17",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.3",
		"nanoid": "^6.0.2",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"zod": "^4.6.5"
	}
}
