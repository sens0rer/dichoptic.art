DATABASE_URL=postgres://postgres:postgres@localhost:5433/dichoptic
PUBLIC_URL=http://localhost:5173
# Secret used to sign local upload URLs and the admin cookie.
SECRET=change-me-dev-secret
ADMIN_TOKEN=change-me-dev-admin
MODERATION=off
# Abuse limits, rolling 24 h window.
FLAG_THRESHOLD=30
PAUSE_THRESHOLD=100
SITE_PAUSE_THRESHOLD=300

# Hosting (Vercel + Neon + Cloudflare R2). Leave STORAGE unset for local disk.
# STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# FILES_BASE=https://img.example.com

# Keep storage inside Cloudflare R2's free 10 GB (sizes in MB).
# STORAGE_LIMIT_MB=6000
# UPLOAD_MB_PER_IP_DAY=300
# UPLOAD_MB_SITE_DAY=1500
